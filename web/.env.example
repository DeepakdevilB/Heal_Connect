NEXT_PUBLIC_API_URL=http://localhost:8082
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional fallback used by next.config.mjs rewrites() when NEXT_PUBLIC_API_URL is unset
BACKEND_URL=http://localhost:8080

# Public site URL used for canonical links, sitemap.xml, robots.txt and OG tags.
# Defaults to the Azure Static Web App URL if unset — update once a custom domain is attached.
NEXT_PUBLIC_SITE_URL=https://blue-plant-0d21bc900.7.azurestaticapps.net

# ─── Admin panel (server-only — do NOT prefix any of these with NEXT_PUBLIC_) ──
# A NEXT_PUBLIC_ var is inlined into the public JS bundle; these four must stay
# server-side only or the admin panel's auth is defeated again. See
# src/app/api/admin/session/route.ts and src/app/api/admin/[...path]/route.ts.

# Must match backend/.env's ADMIN_SECRET_KEY exactly — this is the key the
# Next.js server (not the browser) attaches to proxied /api/admin/* requests.
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Random secret used to sign the admin session cookie. Generate with e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
ADMIN_SESSION_SECRET=generate_a_random_secret_here

# Admin panel login credentials (single shared account for now — per-admin
# accounts with MFA/RBAC is tracked as follow-up work).
ADMIN_LOGIN_EMAIL=admin@healconnect.com
ADMIN_LOGIN_PASSWORD=change_me_to_a_strong_password
