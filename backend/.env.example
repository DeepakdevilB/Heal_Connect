PORT=8080

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/healconnect"

# JWT Secrets
JWT_ACCESS_SECRET=your_access_secret_min_64_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_64_chars

# SendGrid
SENDGRID_API_KEY=SG.xxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=HealConnect

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Twilio Verify — international numbers (non-+91)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxx

# MSG91 — Indian numbers (+91)
# Get these from https://msg91.com/
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=profile-photos

# Redis
REDIS_URL="redis://localhost:6379"

# Frontend URL (for email links & CORS)
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Razorpay (wallet recharge)
RAZORPAY_KEY_ID=rzp_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Required in production — the webhook route now refuses to process events without
# this set (previously fell back to a hardcoded, publicly-visible dummy secret).
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe (wallet recharge)
STRIPE_SECRET_KEY=sk_xxxxxxxxxxxx
# Required in production — same fail-closed behavior as RAZORPAY_WEBHOOK_SECRET above.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Deepgram (live call speech-to-text)
# BOTH vars are required to enable STT — if either is missing, the /api/deepgram/token
# route reports isConfigured: false instead of ever sending the raw API key to the
# browser. Do not deploy with only DEEPGRAM_API_KEY set.
DEEPGRAM_API_KEY=your_deepgram_master_api_key
DEEPGRAM_PROJECT_ID=your_deepgram_project_id

# Admin Panel — required, no hardcoded fallback. If unset, requireAdmin fails
# every admin request closed (500) rather than accepting a known default.
# Must match the web app's ADMIN_SECRET_KEY exactly (see web/.env.example).
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Local development only — set to 'true' to skip starting the billing engine worker locally
DISABLE_BILLING_ENGINE=false
